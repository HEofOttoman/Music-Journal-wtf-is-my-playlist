---

import "../styles/global.css";

import Layout from "../layouts/layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { date, string } from "astro:schema";

import { Image } from "astro:assets";
import walkingLarp from '../assets/thewalkinglarp.jpg';
//import Image from "astro/components/Image.astro";

import albumQuilt from '../assets/chartwave-henrywau-quilt-5x5-pink-3month.png';

const API_KEY = import.meta.env.LASTFM_API_KEY;
const USERNAME = "henrywau"; //import.meta.env.LASTFM_USERNAME;
const BASE = `https://ws.audioscrobbler.com/2.0/?method=`

// if (!response.ok) {
//   const errorText = await response.text();
//   console.error("Last.fm Error Response:", errorText);
//   throw new Error(`Failed to fetch Last.fm data: ${response.status}`);
// }

const recentTracksUrl = `${BASE}user.getrecenttracks&user=${USERNAME}&api_key=${API_KEY}&format=json&limit=5`;
const topTracksUrl = `${BASE}user.gettoptracks&user=${USERNAME}&api_key=${API_KEY}&format=json&limit=6&period=overall`;

const [recentRes, topRes] = await Promise.all([
  fetch(recentTracksUrl),
  fetch(topTracksUrl)
]);

const recentData = await recentRes.json();
const topData = await topRes.json();

const recentTracks = recentData.recenttracks.track;
const topTracks = topData.toptracks.track;

interface TrackImage {
  '#text': string;
  size: 'small' | 'medium' | 'large' | 'extralarge';
}

// putting a constant down here causes a unterminated literal error apparently

interface Track {
  name: string;
  playcount: string;
  url: string;
  artist: {
    name: string;
    mbid: String;
  };
  image: TrackImage[];

}

